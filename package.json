{
  "name": "adineu-fantasy",
  "version": "0.1.0",
  "private": false,
  "description": "Public clubhouse and data pipeline for the Adineu NFL fantasy league (Yahoo 2019\u20132025 archive, Sleeper live sync).",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "PORT=8000 node server.js",
    "check": "node scripts/verify-static.js",
    "test": "node --test",
    "sync:sleeper": "node scripts/sync-sleeper.js",
    "sync:sleeper:production": "node --env-file=.env.production scripts/sync-sleeper.js",
    "analyze:trades": "node scripts/analyze-trades.js",
    "context": "node scripts/league-context.js",
    "waivers": "node scripts/league-context.js --free-agents",
    "backtest": "node scripts/backtest-usage.js",
    "backtest:defense": "node scripts/backtest-defense.js",
    "backtest:ffopportunity": "node scripts/backtest-ffopportunity.js",
    "backtest:trade-value": "node scripts/backtest-trade-value.js",
    "calibrate:boom-bust": "node scripts/calibrate-boom-bust.js",
    "calibrate:faab": "node scripts/calibrate-faab.js",
    "decisions:sync": "node scripts/decision-log.js",
    "decisions:sync:production": "node --env-file=.env.production scripts/decision-log.js",
    "assets:version": "node scripts/asset-versions.js",
    "assets:check": "node scripts/asset-versions.js --check",
    "track:weekly": "node scripts/model-tracking.js",
    "track:weekly:production": "node --env-file=.env.production scripts/model-tracking.js",
    "prelock": "node scripts/prelock-check.js",
    "advisor": "node scripts/lineup-advisor.js",
    "decision:snapshot": "node scripts/decision-snapshot.js",
    "decision:evaluate": "node scripts/decision-outcomes.js",
    "decision:journal": "node scripts/decision-journal.js",
    "projections:collect": "node scripts/collect-projections.js",
    "wopr:validate": "node scripts/wopr-evidence.js validate",
    "wopr:compare": "node scripts/wopr-evidence.js compare",
    "sos:track": "node scripts/sos-tracking.js",
    "sos:track:production": "node --env-file=.env.production scripts/sos-tracking.js",
    "experts:capture": "node scripts/expert-benchmark.js",
    "experts:capture:production": "node --env-file=.env.production scripts/expert-benchmark.js"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.112.0"
  }
}
